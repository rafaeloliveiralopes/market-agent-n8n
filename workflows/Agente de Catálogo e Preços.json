      "id": "1b417ef5-07ad-48d8-a718-9e71db0b6f2f",
      "name": "Buscar Produtos",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -96,
        320
      ],
      "credentials": {
        "supabaseApi": {
          "id": "MNzl5zkOYbmaa4r8",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Processar resultados da busca\nconst items = $input.all();\nconst isAlternativa = $input.first().json.is_alternativa || false;\n\n// Filtrar apenas itens válidos (com id e nome)\nconst itemsValidos = items.filter(item => {\n  const p = item.json;\n  return p.id != null && (p.produto || p.nome) != null;\n});\n\nif (itemsValidos.length === 0) {\n  return [{\n    json: {\n      encontrou: false,\n      total: 0,\n      produtos: [],\n      mensagem: \"Nenhum produto encontrado com os critérios informados.\"\n    }\n  }];\n}\n\n// Formatar produtos\nconst produtos = itemsValidos.map(item => {\n  const p = item.json;\n  return {\n    id: p.id,\n    nome: p.produto || p.nome,\n    categoria: p.categoria,\n    tipo: p.tipo,\n    marca: p.marca,\n    preco: parseFloat(p.preco_decimal),\n    preco_formatado: `R$ ${parseFloat(p.preco_decimal).toFixed(2).replace('.', ',')}`,\n    tamanho: p.massa_volume,\n    estoque_disponivel: p.estoque_disponivel,\n    em_estoque: p.estoque_disponivel > 0\n  };\n});\n\n// Calcular estatísticas\nconst precos = produtos.map(p => p.preco);\nconst precoMedio = precos.reduce((a, b) => a + b, 0) / precos.length;\nconst precoMinimo = Math.min(...precos);\nconst precoMaximo = Math.max(...precos);\n\n// Agrupar por categoria\nconst categorias = [...new Set(produtos.map(p => p.categoria).filter(c => c))];\n\nconst mensagemFinal = isAlternativa \n  ? `Não encontramos exatamente o que você pediu, mas temos ${produtos.length} opção(ões) disponível(is) que podem te interessar.`\n  : `Encontrados ${produtos.length} produto(s) correspondente(s).`;\n\nreturn [{\n  json: {\n    encontrou: !isAlternativa,\n    total: produtos.length,\n    produtos: produtos,\n    estatisticas: {\n      preco_minimo: parseFloat(precoMinimo.toFixed(2)),\n      preco_maximo: parseFloat(precoMaximo.toFixed(2)),\n      preco_medio: parseFloat(precoMedio.toFixed(2)),\n      categorias_encontradas: categorias\n    },\n    mensagem: mensagemFinal\n  }\n}];"
      },
